// 赛夫严选 — Prisma Schema
// 数据库: PostgreSQL (Neon)
// ORM 版本: Prisma 6.x

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════
// 用户
// ═══════════════════════════════════
model User {
  id           String   @id @default(cuid())
  phoneHash    String   @unique
  passwordHash String?
  nickname     String?
  avatarUrl    String?  // 头像（OSS 公开 URL，消费侧 isOssUrl 校验）
  role         String   @default("USER") // USER | BRAND | ADMIN | SUPER
  status       String   @default("ACTIVE") // ACTIVE | DISABLED（管理后台禁用/启用；禁用用户不可登录）
  ageVerified  Boolean  @default(false)
  failedLoginAttempts Int      @default(0) // 密码登录连续失败次数（≥5 触发锁定）
  lockUntil    DateTime?                    // 密码登录锁定至该时间（爆破防护）
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cartItems      CartItem[]
  orders         Order[]
  brand          Brand?           @relation("BrandOwner")
  refreshTokens  RefreshToken[]
  inviteCodesCreated InviteCode[] @relation("InviteCreator")
  serviceTickets ServiceTicket[]
}

// ═══════════════════════════════════
// JWT Refresh Token 轮换
// ═══════════════════════════════════
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  // 软吊销时间：轮换/登出时置非空而非物理删除，
  // 使「已轮换的旧 token 被重放」可被检测（令牌失窃信号，见 auth.service refreshAccessToken）
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ═══════════════════════════════════
// 品牌
// ═══════════════════════════════════
model Brand {
  id         String   @id @default(cuid())
  name       String
  logo       String?
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  inviteCode String   @unique
  ownerId    String   @unique // 一个用户只能拥有一个品牌
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner    User       @relation("BrandOwner", fields: [ownerId], references: [id])
  products Product[]
}

// ═══════════════════════════════════
// 品牌入驻邀请码（预生成，注册品牌时消耗）
// ═══════════════════════════════════
model InviteCode {
  id        String   @id @default(cuid())
  code      String   @unique          // 邀请码明文（统一大写），自然键（upsert 键）
  status    String   @default("UNUSED") // UNUSED | USED | DISABLED（EXPIRED 由 expiresAt 读取时推导，不落库；DISABLED 为管理端主动作废）
  createdBy String?                   // 创建人（注销置空，保留邀请码历史）
  usedBy    String?                    // 使用用户 id（仅参考，无外键约束，参照 OrderItem.productId 模式）
  createdAt DateTime @default(now())
  usedAt    DateTime?
  expiresAt DateTime?                  // 过期时间（null = 永不过期）

  creator User? @relation("InviteCreator", fields: [createdBy], references: [id])
}

// ═══════════════════════════════════
// 商品
// ═══════════════════════════════════
model Product {
  id          String   @id @default(cuid())
  brandId     String
  name        String
  description String?
  category    String
  subCategory String?   // 子类（两级类目；新提交必填，旧数据可空兼容）
  images      Json     @default("[]")  // 图片列表 JSON: ["url1", "url2"]
  certificates Json    @default("[]")  // 检测证书 JSON: [{url, name, mime}]
  specs       Json?                    // 规格参数 JSONB
  price       Int                      // 价格（分）
  stock       Int                      // 库存
  version     Int      @default(0)     // 乐观锁版本号
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  sales       Int      @default(0)     // 销量
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand Brand    @relation(fields: [brandId], references: [id])
}

// ═══════════════════════════════════
// 购物车
// ═══════════════════════════════════
model CartItem {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  productName String   // 展示冗余（下单时对最新价格进行校验）
  price       Int      // 展示冗余（下单时从 Product 实时校验）
  qty         Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ═══════════════════════════════════
// 订单
// ═══════════════════════════════════
model Order {
  id              String   @id @default(cuid())
  userId          String?                  // 注销置空 → 订单历史匿名保留（订单数据本体与地址均不删除）
  total           Int                      // 下单快照总价（分）
  status          String   @default("PENDING")
  // PENDING → PAID → SHIPPED → DELIVERED → COMPLETED
  // PENDING → CANCELLED（仅未支付订单可取消，见 README API 契约）
  // PAID    → REFUND_REQUESTED → REFUNDED（管理员同意退款）
  outTradeNo      String?  @unique         // 商户订单号（= 订单 id，回调幂等键）
  alipayTradeNo   String?                  // 支付宝真实交易流水号（回调 trade_no）
  privacy         Json     @default("{}")  // 隐私选项
  shippingAddress String   // AES-256-GCM 加密后的配送地址
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  refundedAt      DateTime?
  destroyedAt     DateTime?  // 一键销毁时间：非空 = 已销毁。用户/品牌侧查询过滤 destroyedAt IS NULL，
                             // 管理后台保留（privacy.destroyed 仍写，供后台显示标记）
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user  User?       @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@index([userId, createdAt(sort: Desc)])
  // M16：sweep（order-timeout-cancel 按 PENDING、order-delivery-complete 按 DELIVERED）
  // 与管理后台按 status 分页均为热查询，此前仅 userId 索引 → 全表扫描
  @@index([status, createdAt(sort: Desc)])
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  productName String // 下单时快照
  price       Int    // 实付分摊价（分），已含优惠券/满减分摊
  qty         Int
  productId   String? // 仅作参考外键，商品下架不影响历史订单

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  // M16：品牌方按商品查订单（items: { some: { productId: { in } } }）为热查询，
  // 此前 OrderItem 无 productId 索引 → 品牌订单列表/概览全表扫描
  @@index([productId])
}

// ═══════════════════════════════════
// 品类质检模板（二期）
// ═══════════════════════════════════
model CategoryAuditTemplate {
  id           String @id @default(cuid())
  categoryId   String @unique
  requiredDocs Json   @default("[]")  // 文档列表
  checkPoints  Json   @default("[]")  // 质检项 JSONB
}

// ═══════════════════════════════════
// 短信验证码（Serverless 兼容，DB 存储替代内存 Map）
// ═══════════════════════════════════
model VerificationCode {
  id        String   @id @default(cuid())
  phoneHash String                            // 手机号哈希 SHA-256(pepper+phone)，不存明文
  codeHash  String                            // SHA-256(验证码)，不存明文（E4：防 DB 泄露直接接管账号）
  attempts  Int      @default(0)              // 验证尝试次数（≥5 自动销毁，防在线爆破）
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phoneHash, createdAt])
}

// ═══════════════════════════════════
// 通用限流桶（DB 原子计数限流）
// ═══════════════════════════════════
// 用 INSERT..ON CONFLICT DO UPDATE（单语句原子）做计数闸门，替代 check-then-act
// 竞态。唯一键 (scope, bucketKey, bucketStart) 保证同桶并发只递增一次。
// 用途示例：
//   sms:phone  —— 60s 同号发送窗口（key=SHA-256 手机号，bucket=1min）
//   sms:ip     —— IP 维度发送限流（key=SHA-256 IP，bucket=1min / 1day）
//   upload:daily —— 每用户每日上传配额（key=userId，bucket=1day）
model RateLimitBucket {
  id          String   @id @default(cuid())
  scope       String   // 限流维度：sms:phone / sms:ip / upload:daily
  bucketKey   String   // 维度内实体键（哈希后的手机号 / IP / 用户 id）
  bucketStart DateTime // 桶起始时间（floor(now/bucketMs)*bucketMs）
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, bucketKey, bucketStart])
  @@index([scope, bucketStart])
}

// ═══════════════════════════════════
// 咨询工单（客服处理售前售后）
// ═══════════════════════════════════
model ServiceTicket {
  id        String   @id @default(cuid())
  userId    String?                  // 提交用户（注销置空 → 匿名工单，对话记录保留）
  title     String                   // 咨询主题
  category  String                   // PRESALE | AFTERSALE | OTHER
  status    String   @default("OPEN") // OPEN | PROCESSING | RESOLVED | CLOSED
  orderId   String?                  // 关联订单（售后咨询可关联）
  productId String?                  // 关联商品（售前咨询可关联）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  closedAt  DateTime?                // 解决/关闭时间

  user     User?                  @relation(fields: [userId], references: [id])
  messages ServiceTicketMessage[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model ServiceTicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  senderId   String?                  // 发送者（注销置空）
  senderRole String                   // USER | CUSTOMER_SERVICE | ADMIN | SUPER（角色快照，注销后仍可辨发言方）
  content    String
  isRead     Boolean  @default(false) // 客服未读标记（新用户消息置 false）
  createdAt  DateTime @default(now())

  ticket ServiceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// ═══════════════════════════════════
// 审计日志
// ═══════════════════════════════════
model AuditLog {
  id         String   @id @default(cuid())
  targetType String   // Order | Product | Brand | User
  targetId   String
  action     String
  snapshot   Json?                    // 操作前数据快照 JSONB
  operatorId String?
  createdAt  DateTime @default(now())
}
