    "postcss": "^8.4.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "@eslint/eslintrc": "^3.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint-config-next": "15.x",
    "eslint-plugin-boundaries": "^5.0.0",
    "vitest": "^3.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@playwright/test": "^1.50.0",
    "tsx": "^4.0.0"
