    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "next": "15.x",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@prisma/client": "^6.0.0",
    "jose": "^5.0.0",
    "zod": "^3.23.0",
    "@asteasolutions/zod-to-openapi": "^7.0.0",
    "next-safe-action": "^7.0.0",
    "inngest": "^3.20.0",
    "@sentry/nextjs": "^8.0.0",
    "big.js": "^7.0.0",
    "alipay-sdk": "^3.3.0"
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
