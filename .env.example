# ── 数据库 ──
# 本地 Docker PostgreSQL
DATABASE_URL="postgresql://saife:saife123@localhost:5432/saife?schema=public"
# Neon 生产连接串
# DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/saife?sslmode=require"
# Prisma 迁移用直连 URL（Neon 需要）
# DIRECT_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/saife?sslmode=require"

# ── JWT ──
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET="your-jwt-secret-replace-in-production"

# ── 短信（阿里云，可选） ──
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=

# ── 支付（支付宝沙箱） ──
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# ── 基础 URL ──
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ── 加密（生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"） ──
# ENCRYPTION_KEYS="v1:your-key-replace-in-production"

# ── 手机号哈希 pepper ──
# PEPPER="your-pepper-replace-in-production"

# ── Inngest（可选，未配置时异步函数不投递） ──
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# ── Sentry（可选） ──
# SENTRY_DSN=

# ── Redis（预留） ──
# REDIS_URL=
